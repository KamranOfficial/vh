---
interface Props { base: string; name: string }
const { base, name } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '');
const links = [
  { label: 'Overview', href: base },
  { label: 'Rooms & suites', href: `${base}/rooms` },
  { label: 'Dining', href: `${base}/dining` },
  { label: 'Facilities', href: `${base}/facilities` },
];
---

<nav class="subnav" aria-label={`${name} sections`}>
  <div class="shell subnav-inner">
    <span class="subnav-name">{name}</span>
    <ul>
      {
        links.map((l) => (
          <li>
            <a href={l.href} class:list={[path === l.href && 'is-active']}>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>

<style>
  .subnav {
    position: sticky;
    top: var(--hdr-h);
    z-index: 90;
    background: var(--cream);
    border-bottom: 1px solid var(--line);
  }
  .subnav-inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    min-height: 58px;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .subnav-inner::-webkit-scrollbar { display: none; }
  .subnav-name {
    font-family: var(--font-display);
    font-size: 1.05rem;
    white-space: nowrap;
    flex: none;
  }
  .subnav ul {
    display: flex;
    gap: 1.6rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .subnav a {
    font-size: 0.76rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--ink-3);
    padding-block: 0.4rem;
    border-bottom: 1px solid transparent;
    transition: color 0.3s var(--ease), border-color 0.3s var(--ease);
  }
  .subnav a:hover { color: var(--ink); }
  .subnav a.is-active { color: var(--ink); border-color: var(--clay); }
</style>
