---
interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  align?: 'left' | 'center';
  light?: boolean;
}
const { eyebrow, title, lede, align = 'left', light = false } = Astro.props;
---

<div class:list={['sh', `sh-${align}`, light && 'sh-light', 'reveal']}>
  {eyebrow && <p class:list={['eyebrow', light && 'eyebrow-light']}>{eyebrow}</p>}
  <h2 class="sh-title">{title}</h2>
  {lede && <p class="lede">{lede}</p>}
  <slot />
</div>

<style>
  .sh { display: flex; flex-direction: column; gap: 1rem; max-width: 68ch; }
  .sh-center { align-items: center; text-align: center; margin-inline: auto; }
  .sh-title { font-size: var(--text-3xl); }
  .sh-light .sh-title { color: var(--cream); }
</style>
