---
import { site } from '../data/site';
interface Props {
  title?: string;
  text?: string;
  href?: string;
  label?: string;
}
const {
  title = 'Book online today and look forward to a relaxing stay with us',
  text = `Our reservations desk answers around the clock. Call ${site.phone} or write to us and we will hold the right room for you.`,
  href,
  label = 'Check availability',
} = Astro.props;
---

<section class="cta on-ink">
  <div class="shell cta-inner reveal">
    <div>
      <p class="eyebrow eyebrow-light">Reservations</p>
      <h2 class="cta-title">{title}</h2>
      <p class="lede">{text}</p>
    </div>
    <div class="cta-actions">
      {
        href ? (
          <a class="btn btn-primary" href={href} target="_blank" rel="noopener">
            {label}
          </a>
        ) : (
          <a class="btn btn-primary" href="/contact">
            Enquire &amp; book
          </a>
        )
      }
      <a class="btn btn-light" href={site.phoneHref}>{site.phone}</a>
      <a class="cta-mail" href={`mailto:${site.email}`}>{site.email}</a>
    </div>
  </div>
</section>

<style>
  .cta { padding-block: clamp(3rem, 7vw, 5.5rem); }
  .cta-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.8fr);
    gap: clamp(1.75rem, 5vw, 4rem);
    align-items: center;
  }
  .cta-title {
    font-size: var(--text-2xl);
    color: var(--cream);
    margin: 0.75rem 0 0.9rem;
    max-width: 22ch;
  }
  .cta-actions { display: flex; flex-direction: column; align-items: flex-start; gap: 0.9rem; }
  .cta-mail { font-size: var(--text-sm); color: #b6ac9d; }
  .cta-mail:hover { color: #fff; }
  @media (max-width: 820px) {
    .cta-inner { grid-template-columns: minmax(0, 1fr); }
  }
</style>
