---
import Figure from './Figure.astro';
import type { Room } from '../data/rooms';
import { formatAed } from '../data/booking';

interface Props { room: Room; hotel: 'grand' | 'village'; index?: number }
const { room, hotel, index = 0 } = Astro.props;
const shown = room.amenities.slice(0, 6);
const rest = room.amenities.length - shown.length;
const bookHref = `/book?hotel=${hotel}&room=${room.code}`;
---

<article class="room reveal" style={`transition-delay:${Math.min(index, 4) * 60}ms`}>
  <Figure
    src={room.image}
    alt={`${room.name} at Villaggio Hotels`}
    ratio="ar-4-3"
    sizes="(max-width: 760px) 92vw, 46vw"
  />
  <div class="room-body">
    <div class="room-head">
      <h3 class="room-name">{room.name}</h3>
      <div class="price-tag">
        <span class="price-amount">{formatAed(room.pricePerNight)}</span>
        <span class="price-unit">/ night</span>
      </div>
    </div>
    <p class="room-facts">
      <span>{room.size}</span><span class="dot" aria-hidden="true">·</span><span>{room.bed}</span><span class="dot" aria-hidden="true">·</span><span>{room.sleeps}</span>
    </p>
    <p class="room-blurb">{room.blurb}</p>
    <ul class="room-am">
      {shown.map((a) => <li>{a}</li>)}
      {rest > 0 && <li class="more">+{rest} more</li>}
    </ul>
    <a class="btn-book" href={bookHref} data-testid={`book-${room.code}`}>
      Book this room
      <svg width="14" height="10" viewBox="0 0 14 10" fill="none" aria-hidden="true">
        <path d="M0 5h12M8.5 1 12.5 5l-4 4" stroke="currentColor" stroke-width="1.4"></path>
      </svg>
    </a>
  </div>
</article>

<style>
  .room {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .room-body {
    padding: clamp(1.4rem, 2.6vw, 2.1rem);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
  }
  .room-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    width: 100%;
  }
  .room-name { font-size: var(--text-xl); flex: 1; }
  .price-tag { flex: none; }
  .room-facts {
    font-size: var(--text-sm);
    color: var(--ink-3);
    letter-spacing: 0.02em;
    display: flex;
    flex-wrap: wrap;
    gap: 0.2em;
  }
  .dot { margin-inline: 0.4em; }
  .room-blurb { color: var(--ink-2); font-size: 0.95rem; }
  .room-am {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .room-am li {
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    padding: 0.35em 0.7em;
    background: var(--sand);
    color: var(--ink-2);
    border-radius: 100px;
  }
  .room-am .more { background: transparent; color: var(--ink-3); }
</style>
