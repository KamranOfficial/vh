---
import Figure from './Figure.astro';
import type { Room } from '../data/rooms';

interface Props { room: Room; bookHref: string; index?: number }
const { room, bookHref, index = 0 } = Astro.props;
const shown = room.amenities.slice(0, 6);
const rest = room.amenities.length - shown.length;
---

<article class="room reveal">
  <Figure
    src={room.image}
    alt={`${room.name} at Villaggio Hotels`}
    ratio="ar-4-3"
    sizes="(max-width: 760px) 92vw, 46vw"
  />
  <div class="room-body">
    <div class="room-head">
      <h3 class="room-name">{room.name}</h3>
      <p class="room-facts">
        <span>{room.size}</span><span class="dot" aria-hidden="true">·</span><span>{room.bed}</span>
      </p>
    </div>
    <p class="room-blurb">{room.blurb}</p>
    <ul class="room-am">
      {shown.map((a) => <li>{a}</li>)}
      {rest > 0 && <li class="more">+{rest} more</li>}
    </ul>
    <a class="link-arrow" href={bookHref} rel="noopener" target="_blank">
      Check availability
      <svg width="14" height="10" viewBox="0 0 14 10" fill="none" aria-hidden="true">
        <path d="M0 5h12M8.5 1 12.5 5l-4 4" stroke="currentColor" stroke-width="1.4"></path>
      </svg>
    </a>
  </div>
</article>

<style>
  .room {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .room-body {
    padding: clamp(1.4rem, 2.6vw, 2.1rem);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
  }
  .room-name { font-size: var(--text-xl); }
  .room-facts {
    margin-top: 0.4rem;
    font-size: var(--text-sm);
    color: var(--ink-3);
    letter-spacing: 0.02em;
  }
  .dot { margin-inline: 0.5em; }
  .room-blurb { color: var(--ink-2); font-size: 0.95rem; }
  .room-am {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .room-am li {
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    padding: 0.35em 0.7em;
    background: var(--sand);
    color: var(--ink-2);
    border-radius: 100px;
  }
  .room-am .more { background: transparent; color: var(--ink-3); }
  .link-arrow { margin-top: auto; }
</style>
