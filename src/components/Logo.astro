---
/**
 * Villaggio Hotels & Resorts brand mark.
 *
 * Draws from the <LogoSprite /> artwork rendered once per document, so placing the
 * logo twice on a page costs two <use> elements rather than two copies of the paths.
 *
 * variant="wordmark"  gold "villaggio" + wheat emblem only. Use in tight spots such
 *                     as the header, where the tagline would render a few pixels tall.
 * variant="lockup"    wordmark plus the "Hotels & Resorts" tagline. The tagline is
 *                     filled with currentColor, so set `color` on an ancestor: ink on
 *                     cream, white on dark. Give it at least 80px of height or the
 *                     tagline becomes unreadable.
 */
interface Props {
  class?: string;
  height?: number;
  variant?: 'wordmark' | 'lockup';
  label?: string;
}

const {
  class: cls = '',
  height = 40,
  variant = 'wordmark',
  label = 'Villaggio Hotels & Resorts',
} = Astro.props;

const VB_W = 2048;
const VB_H = 678;
const width = Math.round(height * (VB_W / VB_H));
---

<svg
  class:list={['vh-logo', cls]}
  width={width}
  height={height}
  viewBox={`0 0 ${VB_W} ${VB_H}`}
  role="img"
  aria-label={label}
  xmlns="http://www.w3.org/2000/svg"
>
  <use href="#vh-word"></use>
  {variant === 'lockup' && <use href="#vh-tag"></use>}
</svg>

<style>
  .vh-logo {
    display: block;
    height: auto;
    max-width: 100%;
  }
</style>
