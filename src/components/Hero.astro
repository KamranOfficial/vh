---
import { Image } from 'astro:assets';
import { img } from '../data/images';

interface Props {
  image: string;
  alt: string;
  eyebrow?: string;
  title: string;
  sub?: string;
  height?: 'full' | 'tall' | 'mid';
  align?: 'center' | 'left';
  ctaHref?: string;
  ctaLabel?: string;
  secondHref?: string;
  secondLabel?: string;
  position?: string;
}
const {
  image,
  alt,
  eyebrow,
  title,
  sub,
  height = 'tall',
  align = 'center',
  ctaHref,
  ctaLabel,
  secondHref,
  secondLabel,
  position = '50% 50%',
} = Astro.props;
---

<section class:list={['hero', `h-${height}`, `a-${align}`]}>
  <div class="hero-bg">
    <Image
      src={img(image)}
      alt={alt}
      widths={[640, 1024, 1600, 2000]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      format="webp"
      quality={72}
      style={`object-position:${position}`}
    />
  </div>
  <div class="hero-veil"></div>
  <div class="shell hero-inner">
    {eyebrow && <p class="eyebrow eyebrow-light">{eyebrow}</p>}
    <h1 class="hero-title">{title}</h1>
    {sub && <p class="hero-sub">{sub}</p>}
    {
      (ctaHref || secondHref) && (
        <div class="hero-cta">
          {ctaHref && (
            <a href={ctaHref} class="btn btn-primary">
              {ctaLabel}
            </a>
          )}
          {secondHref && (
            <a href={secondHref} class="btn btn-light">
              {secondLabel}
            </a>
          )}
        </div>
      )
    }
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    color: #fff;
    isolation: isolate;
    overflow: hidden;
  }
  .h-full { min-height: min(100svh, 900px); }
  .h-tall { min-height: min(78svh, 760px); }
  .h-mid { min-height: min(56svh, 540px); }
  .hero-bg { position: absolute; inset: 0; z-index: -2; }
  .hero-bg :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .hero-veil {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(120% 90% at 50% 78%, rgba(12, 9, 6, 0.55) 0%, rgba(12, 9, 6, 0) 70%),
      linear-gradient(to top, rgba(12, 9, 6, 0.88) 0%, rgba(12, 9, 6, 0.52) 45%, rgba(12, 9, 6, 0.42) 100%);
  }
  .hero-inner {
    padding-block: clamp(3rem, 8vw, 6rem);
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }
  .a-center .hero-inner {
    align-items: center;
    text-align: center;
    padding-bottom: clamp(3.5rem, 9vw, 7rem);
  }
  .hero-title {
    font-size: var(--text-hero);
    max-width: 18ch;
    text-shadow: 0 1px 26px rgba(10, 7, 4, 0.4);
    font-variation-settings: 'SOFT' 40, 'WONK' 1;
  }
  .a-center .hero-title { max-width: 20ch; }
  .hero-sub {
    font-size: var(--text-lg);
    max-width: 54ch;
    color: rgba(255, 255, 255, 0.95);
    text-shadow: 0 1px 18px rgba(10, 7, 4, 0.55);
  }
  .eyebrow-light { color: rgba(255, 255, 255, 0.92); text-shadow: 0 1px 14px rgba(10, 7, 4, 0.6); }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 0.85rem; margin-top: 0.7rem; }
</style>
