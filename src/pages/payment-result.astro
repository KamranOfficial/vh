---
import Base from '../layouts/Base.astro';
---

<Base
  title="Payment result"
  description="Your Villaggio Hotels booking payment result."
>
  <section class="section">
    <div class="shell">
      <div class="result-card reveal" id="result">

        <div
          class="result-icon pending"
          id="r-icon"
        >
          <svg
            width="28"
            height="28"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>
          </svg>
        </div>

        <p
          class="eyebrow"
          id="r-eyebrow"
        >
          Verifying
        </p>

        <h1
          class="result-state"
          id="r-state"
        >
          Checking your payment…
        </h1>

        <p
          class="lede"
          id="r-msg"
          style="margin-inline:auto"
        >
          Please wait while we confirm your payment with N-Genius Online.
        </p>

        <p
          class="result-ref"
          id="r-ref"
        ></p>

        <div
          style="margin-top:2rem;display:flex;gap:0.8rem;justify-content:center;flex-wrap:wrap"
        >
          <a
            class="btn btn-primary"
            href="/book"
          >
            Book another stay
          </a>

          <a
            class="btn btn-ghost"
            href="/"
          >
            Back to home
          </a>
        </div>

      </div>
    </div>
  </section>
</Base>

<script is:inline>
  (function () {

    const $ = (id) =>
      document.getElementById(id);

    const params =
      new URLSearchParams(
        location.search
      );

    /*
     * N-Genius adds:
     *
     * ?ref=<N-GENIUS-ORDER-REFERENCE>
     */
    const ref =
      params.get('ref') || '';

    const icon =
      $('r-icon');

    const eyebrow =
      $('r-eyebrow');

    const state =
      $('r-state');

    const msg =
      $('r-msg');

    const refEl =
      $('r-ref');

    if (ref) {
      refEl.textContent =
        'Payment reference: ' + ref;
    }

    const OK = `
      <svg width="28" height="28"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5">
        <path d="M20 6 9 17l-5-5"/>
      </svg>
    `;

    const PEND = `
      <svg width="28" height="28"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2">
        <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l-2.83 2.83M16.24 7.76l2.83-2.83"/>
      </svg>
    `;

    const FAIL = `
      <svg width="28" height="28"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5">
        <path d="M18 6 6 18M6 6l12 12"/>
      </svg>
    `;

    function show(
      kind,
      title,
      message
    ) {

      icon.className =
        'result-icon ' + kind;

      icon.innerHTML =
        kind === 'ok'
          ? OK
          : kind === 'fail'
            ? FAIL
            : PEND;

      eyebrow.textContent =
        kind === 'ok'
          ? 'Confirmed'
          : kind === 'fail'
            ? 'Not completed'
            : 'Pending';

      state.textContent =
        title;

      msg.textContent =
        message;
    }

    async function check() {

      if (!ref) {

        show(
          'fail',
          'Payment reference missing',
          'We could not find the N-Genius payment reference. Please return to the booking page and try again.'
        );

        return;
      }

      try {

        const response =
          await fetch(
            `/api/order-status?ref=${encodeURIComponent(ref)}`
          );

        const data =
          await response.json();

        if (!response.ok) {

          show(
            'fail',
            'Unable to verify payment',
            data.detail ||
              'We could not verify the payment with N-Genius. Please contact the hotel before making another payment.'
          );

          return;
        }

        const stateValue =
          String(
            data.state ||
              'UNKNOWN'
          ).toUpperCase();

        /*
         * ONLY these states can show
         * a successful payment.
         */
        if (
          data.paid === true ||
          [
            'PURCHASED',
            'CAPTURED',
            'SETTLED',
          ].includes(stateValue)
        ) {

          show(
            'ok',
            'Payment confirmed',
            'Thank you. Your payment has been successfully received by N-Genius Online.'
          );

          return;
        }

        if (
          [
            'FAILED',
            'DECLINED',
            'CANCELLED',
            'REVERSED',
          ].includes(stateValue)
        ) {

          show(
            'fail',
            'Payment not completed',
            'Your payment was not completed. No successful payment was confirmed.'
          );

          return;
        }

        show(
          'pending',
          'Payment processing',
          'Your payment is still being processed. Please do not make another payment until the current payment status is confirmed.'
        );

      } catch (error) {

        console.error(
          'Payment verification error',
          error
        );

        show(
          'fail',
          'Unable to verify payment',
          'We could not confirm the payment status with N-Genius. Please contact the hotel before making another payment.'
        );
      }
    }

    check();

  })();
</script>
