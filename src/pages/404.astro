---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="The page you were looking for is not here.">
  <section class="nf">
    <div class="shell">
      <p class="eyebrow">404</p>
      <h1 class="nf-t">This page has checked out</h1>
      <p class="lede">
        The link may be old, or we may have moved things around. Try one of these instead.
      </p>
      <div class="nf-a">
        <a class="btn btn-primary" href="/">Home</a>
        <a class="btn btn-ghost" href="/grand-villaggio">Grand Villaggio</a>
        <a class="btn btn-ghost" href="/villaggio">Villaggio Hotel</a>
        <a class="btn btn-ghost" href="/contact">Contact</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf { padding-block: clamp(5rem, 14vw, 10rem); }
  .nf-t { font-size: var(--text-3xl); margin: 0.8rem 0 1rem; max-width: 20ch; }
  .nf-a { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
</style>
