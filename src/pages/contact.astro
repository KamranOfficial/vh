---
import Base from '../layouts/Base.astro';
import Figure from '../components/Figure.astro';
import { site, hotels, bookingLinks } from '../data/site';

const cards = [
  {
    h: hotels.grand,
    href: '/grand-villaggio',
    book: bookingLinks.grand,
    img: 'gv-exterior-day.webp',
    alt: 'The glass tower of Grand Villaggio Hotel by day',
  },
  {
    h: hotels.village,
    href: '/villaggio',
    book: bookingLinks.village,
    img: 'vh-pool-umbrellas.webp',
    alt: 'Parasols around the pool at Villaggio Hotel',
  },
];

const directory = [
  { l: 'Villaggio Restaurant & Café', v: '+971 50 499 2099', href: 'tel:+971504992099' },
  { l: 'Sahriya Gourmet Restaurant', v: '+971 2 499 2077', href: 'tel:+97124992077' },
  { l: 'Hoods Resto & Bar', v: '+971 50 676 8198', href: 'tel:+971506768198' },
  { l: 'Belle Care Luxury Spa', v: '+971 56 552 0999', href: 'tel:+971565520999' },
];
---

<Base
  title="Contact & Reservations"
  description="Contact Villaggio Hotels & Resorts in Abu Dhabi — reservations on +971 2 499 2000, info@villaggiohotels.ae, and direct numbers for both hotels, restaurants and the spa."
>
  <section class="head">
    <div class="shell">
      <p class="eyebrow">Contact</p>
      <h1 class="head-t">Talk to us</h1>
      <p class="lede">
        Reception at both hotels is staffed 24 hours a day, every day of the year. Call, email, or
        book instantly online — whichever suits you.
      </p>
      <div class="quick">
        <a class="btn btn-primary" href={site.phoneHref}>{site.phone}</a>
        <a class="btn btn-ghost" href={`mailto:${site.email}`}>{site.email}</a>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="shell-wide two">
      {
        cards.map((c) => (
          <article class="hcard reveal">
            <Figure src={c.img} alt={c.alt} ratio="ar-3-2" sizes="(max-width: 860px) 92vw, 46vw" />
            <div class="hcard-b">
              <h2 class="hcard-t">{c.h.name}</h2>
              <dl class="meta">
                <div><dt>Address</dt><dd>{c.h.address}</dd></div>
                <div><dt>Email</dt><dd><a href={`mailto:${c.h.email}`}>{c.h.email}</a></dd></div>
                <div><dt>Reservations</dt><dd><a href={site.phoneHref}>{site.phone}</a></dd></div>
                <div><dt>Rooms</dt><dd>{c.h.rooms} rooms &amp; suites · 4 stars</dd></div>
                <div><dt>Check-in / out</dt><dd>{c.h.checkIn} / {c.h.checkOut}</dd></div>
              </dl>
              <div class="hcard-a">
                <a class="btn btn-primary" href={c.book} target="_blank" rel="noopener">Book online</a>
                <a
                  class="btn btn-ghost"
                  href={`https://www.google.com/maps/search/?api=1&query=${c.h.mapQuery}`}
                  target="_blank"
                  rel="noopener">Directions</a
                >
                <a class="link-arrow" href={c.href}>
                  Hotel page
                  <svg width="14" height="10" viewBox="0 0 14 10" fill="none" aria-hidden="true">
                    <path d="M0 5h12M8.5 1 12.5 5l-4 4" stroke="currentColor" stroke-width="1.4" />
                  </svg>
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section on-sand">
    <div class="shell dir">
      <div class="reveal">
        <p class="eyebrow">Direct lines</p>
        <h2 class="dir-t">Restaurants &amp; spa</h2>
        <p class="muted dir-n">
          For table reservations and treatments you can call the venue directly. The front desk will
          also be happy to arrange it for you.
        </p>
      </div>
      <dl class="dir-list reveal">
        {
          directory.map((d) => (
            <div>
              <dt>{d.l}</dt>
              <dd><a href={d.href}>{d.v}</a></dd>
            </div>
          ))
        }
        <div>
          <dt>Head office</dt>
          <dd>{site.address}</dd>
        </div>
        <div>
          <dt>Opening hours</dt>
          <dd>{site.hours}</dd>
        </div>
      </dl>
    </div>
  </section>
</Base>

<style>
  .head { padding-block: clamp(3rem, 7vw, 5.5rem) clamp(1.5rem, 4vw, 3rem); }
  .head-t { font-size: var(--text-3xl); margin: 0.8rem 0 1rem; }
  .quick { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.75rem; }

  .two { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(1.5rem, 4vw, 3rem); }
  .hcard { display: flex; flex-direction: column; gap: 1.4rem; }
  .hcard-t { font-size: var(--text-xl); }
  .meta { margin: 0; display: grid; gap: 0.9rem; }
  .meta dt { font-size: 0.64rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--ink-3); margin-bottom: 0.25rem; }
  .meta dd { margin: 0; font-size: 0.95rem; }
  .meta a:hover { color: var(--clay); }
  .hcard-a { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.25rem; margin-top: 0.4rem; }

  .dir {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(1.75rem, 5vw, 4rem);
    align-items: start;
  }
  .dir-t { font-size: var(--text-2xl); margin: 0.7rem 0 0.9rem; }
  .dir-n { font-size: 0.92rem; max-width: 34ch; }
  .dir-list { margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.5rem 2.5rem; }
  .dir-list dt { font-size: 0.64rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--ink-3); margin-bottom: 0.35rem; }
  .dir-list dd { margin: 0; font-size: 0.95rem; }
  .dir-list a:hover { color: var(--clay); }

  @media (max-width: 860px) {
    .two, .dir { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 520px) {
    .dir-list { grid-template-columns: minmax(0, 1fr); }
  }
</style>
