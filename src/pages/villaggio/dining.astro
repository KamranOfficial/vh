---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import HotelSubnav from '../../components/HotelSubnav.astro';
import SectionHead from '../../components/SectionHead.astro';
import VenueRow from '../../components/VenueRow.astro';
import CtaBand from '../../components/CtaBand.astro';
import { hotels, bookingLinks } from '../../data/site';
import { villageVenues } from '../../data/venues';

const h = hotels.village;
---

<Base
  title={`Restaurants & Bars — ${h.name}`}
  description="Villaggio Restaurant & Café, Sahriya Gourmet Restaurant, Hoods Resto & Bar and Cubes Club — four dining and nightlife venues at Villaggio Hotel Abu Dhabi."
  overlay
>
  <Hero
    image="vh-restaurant-seating.webp"
    alt="Ochre and red seating at one of Villaggio Hotel's restaurants"
    eyebrow={`${h.name} · Restaurants & bars`}
    title="A culinary journey"
    sub="Authentic Arabic cuisine, Mediterranean plates, a resto bar with live bands, and a club that closes at four."
    height="mid"
  />
  <HotelSubnav base="/villaggio" name={h.name} />

  <section class="section">
    <div class="shell">
      <SectionHead
        eyebrow="Four venues"
        title="Indulge in an exceptional dining experience"
        lede="Savour the rich flavours of authentic Arabic cuisine or explore an array of international dishes crafted by our chefs. Fine dining, a casual meal or a vibrant bar — our kitchens run from breakfast to the early hours."
      />
      <div class="venues">
        {villageVenues.map((v, i) => <VenueRow venue={v} flip={i % 2 === 1} index={i} />)}
      </div>
    </div>
  </section>

  <section class="section on-sand">
    <div class="shell bk">
      <div class="reveal">
        <p class="eyebrow">Breakfast</p>
        <h2 class="bk-t">Continental, buffet or à la carte</h2>
      </div>
      <p class="lede reveal">
        Breakfast at Villaggio scores 8.1 with recent guests on Booking.com. Take it indoors in the
        cool of the dining hall, or outside on the terrace overlooking the pool and the garden.
      </p>
    </div>
  </section>

  <CtaBand
    title="Book a table by the pool"
    text="Villaggio Restaurant & Café takes reservations on +971 50 499 2099. For private events across the venues, our team will put together a proposal the same day."
    href={bookingLinks.village}
    label="Check availability"
  />
</Base>

<style>
  .venues { margin-top: clamp(2.5rem, 6vw, 4.5rem); display: grid; gap: clamp(3rem, 8vw, 6rem); }
  .bk {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(1.5rem, 5vw, 4rem);
    align-items: center;
  }
  .bk-t { font-size: var(--text-2xl); margin-top: 0.7rem; max-width: 16ch; }
  @media (max-width: 820px) { .bk { grid-template-columns: minmax(0, 1fr); } }
</style>
