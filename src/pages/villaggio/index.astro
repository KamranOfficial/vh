---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import HotelSubnav from '../../components/HotelSubnav.astro';
import Figure from '../../components/Figure.astro';
import SectionHead from '../../components/SectionHead.astro';
import PolicyBlock from '../../components/PolicyBlock.astro';
import CtaBand from '../../components/CtaBand.astro';
import { hotels, bookingLinks, site } from '../../data/site';

const h = hotels.village;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Hotel',
  name: h.name,
  starRating: { '@type': 'Rating', ratingValue: 4 },
  telephone: '+97124992000',
  email: h.email,
  numberOfRooms: h.rooms,
  checkinTime: '14:00',
  checkoutTime: '12:00',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Al Salam Street, Al Nahyan',
    addressLocality: 'Abu Dhabi',
    addressCountry: 'AE',
  },
  amenityFeature: [
    'Outdoor swimming pool',
    'Children’s pool',
    'Fitness centre',
    'Spa',
    'Kids’ club',
    'Restaurant',
    'Bar',
    'Meeting rooms',
  ].map((n) => ({ '@type': 'LocationFeatureSpecification', name: n, value: true })),
};

const highlights = [
  { n: '130', l: 'rooms & suites across the villas' },
  { n: '4', l: 'restaurants, bars and clubs' },
  { n: '2', l: 'outdoor pools, one for the kids' },
  { n: '8.1', l: 'guest score for breakfast' },
];
---

<Base
  title={h.name}
  description="Villaggio Hotel Abu Dhabi — a boutique village-style resort on Al Salam Street with 130 rooms and suites, four dining venues, two outdoor pools, a kids' playground and salons."
  overlay
  jsonLd={jsonLd}
>
  <Hero
    image="vh-pool-night.webp"
    alt="Villaggio Hotel's outdoor pool glowing turquoise at night among parasols and palms"
    eyebrow="Al Salam Street · Abu Dhabi · 4 stars"
    title="Villaggio Hotel"
    sub={h.tagline}
    height="tall"
    ctaHref={bookingLinks.village}
    ctaLabel="Check availability"
    secondHref="/villaggio/rooms"
    secondLabel="See the rooms"
  />
  <HotelSubnav base="/villaggio" name={h.name} />

  <section class="section">
    <div class="shell intro">
      <div class="reveal">
        <p class="eyebrow">Welcome</p>
        <h2 class="intro-t">A village you can walk through, ten minutes from the Corniche</h2>
      </div>
      <div class="reveal stack">
        <p class="lede">{h.intro}</p>
        <p class="muted">
          Blending rustic elegance with modern comfort, the hotel is arranged as a collection of
          separate villas, each holding its own rooms and suites. The internal corridors are lined
          with flowers and lush greenery — a tranquil ambiance you would not expect this close to the
          city centre.
        </p>
      </div>
    </div>

    <div class="shell-wide hl-strip">
      {
        highlights.map((x) => (
          <div class="hl reveal">
            <span class="hl-n">{x.n}</span>
            <span class="hl-l">{x.l}</span>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section-tight">
    <div class="shell-wide mosaic">
      <Figure src="vh-suite-royal.webp" alt="The living room of the Royal Suite, opening onto its private pool" ratio="ar-4-3" sizes="(max-width: 900px) 92vw, 50vw" class="m1" />
      <Figure src="vh-restaurant-hall.webp" alt="Villaggio Restaurant & Café's long dining hall in ochre and red" ratio="ar-4-5" sizes="(max-width: 900px) 92vw, 24vw" />
      <Figure src="vh-kids-playground.webp" alt="The covered kids' playground with slides and soft play" ratio="ar-4-5" sizes="(max-width: 900px) 92vw, 24vw" />
    </div>
  </section>

  <section class="section on-ink">
    <div class="shell">
      <SectionHead
        light
        eyebrow="Made for staying put"
        title="Three reasons guests keep coming back"
        lede="Villaggio is built for families and long stays — space to spread out, food at any hour, and enough to do that you never need the car."
      />
      <div class="grid g-3 cards">
        <article class="fcard reveal">
          <h3>Gardens, not corridors</h3>
          <p>
            Aramid ceilings, rich woodwork and natural stone, with vibrant flowers and flourishing
            trees in every corner of the property.
          </p>
        </article>
        <article class="fcard reveal">
          <h3>Four venues, one campus</h3>
          <p>
            Arabic plates at Villaggio Restaurant &amp; Café, Mediterranean at Hoods and Sahriya,
            and Cubes Club when the evening refuses to end.
          </p>
          <a class="link-arrow" href="/villaggio/dining">See the venues<svg width="14" height="10" viewBox="0 0 14 10" fill="none" aria-hidden="true"><path d="M0 5h12M8.5 1 12.5 5l-4 4" stroke="currentColor" stroke-width="1.4"></path></svg></a>
        </article>
        <article class="fcard reveal">
          <h3>Something for the children</h3>
          <p>
            A dedicated kids' pool, a covered playground packed with activities, and a restaurant
            where they can play safely while the adults linger.
          </p>
          <a class="link-arrow" href="/villaggio/facilities">Facilities<svg width="14" height="10" viewBox="0 0 14 10" fill="none" aria-hidden="true"><path d="M0 5h12M8.5 1 12.5 5l-4 4" stroke="currentColor" stroke-width="1.4"></path></svg></a>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="shell loc">
      <div class="reveal stack">
        <p class="eyebrow">Finding us</p>
        <h2 class="loc-t">{h.address}</h2>
        <dl class="loc-meta">
          <div><dt>Reservations</dt><dd><a href={site.phoneHref}>{site.phone}</a></dd></div>
          <div><dt>Hotel email</dt><dd><a href={`mailto:${h.email}`}>{h.email}</a></dd></div>
          <div><dt>Check-in / out</dt><dd>{h.checkIn} / {h.checkOut}</dd></div>
          <div><dt>Centre of Abu Dhabi</dt><dd>About 2.6 km</dd></div>
        </dl>
        <a
          class="btn btn-ghost"
          href={`https://www.google.com/maps/search/?api=1&query=${h.mapQuery}`}
          target="_blank"
          rel="noopener">Open in maps</a
        >
      </div>
      <Figure src="vh-pool-umbrellas.webp" alt="Parasols and loungers around the main pool at Villaggio Hotel" ratio="ar-4-3" sizes="(max-width: 900px) 92vw, 50vw" class="reveal" />
    </div>
  </section>

  <PolicyBlock checkIn={h.checkIn} checkOut={h.checkOut} />
  <CtaBand href={bookingLinks.village} label="Book Villaggio Hotel" />
</Base>

<style>
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: clamp(1.75rem, 5vw, 4rem);
    align-items: start;
  }
  .intro-t { font-size: var(--text-2xl); margin-top: 0.9rem; max-width: 16ch; }

  .hl-strip {
    margin-top: clamp(2.5rem, 6vw, 4.5rem);
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    background: var(--line);
    border-block: 1px solid var(--line);
  }
  .hl { background: var(--cream); padding: clamp(1.2rem, 3vw, 2rem) 1.2rem; }
  .hl-n {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1;
    color: var(--clay);
  }
  .hl-l { display: block; margin-top: 0.5rem; font-size: 0.8rem; color: var(--ink-3); }

  .mosaic {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: clamp(0.75rem, 2vw, 1.25rem);
    align-items: start;
  }

  .cards { margin-top: clamp(2rem, 5vw, 3.5rem); }
  .fcard {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    align-items: flex-start;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
  }
  .fcard h3 { font-size: var(--text-xl); color: var(--cream); }
  .fcard p { color: #c3b9aa; font-size: 0.94rem; }
  .fcard .link-arrow { margin-top: auto; }

  .loc {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: clamp(1.75rem, 5vw, 4rem);
    align-items: center;
  }
  .loc-t { font-size: var(--text-xl); max-width: 24ch; }
  .loc-meta { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.2rem; margin: 0.5rem 0 0; }
  .loc-meta dt { font-size: 0.64rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--ink-3); margin-bottom: 0.3rem; }
  .loc-meta dd { margin: 0; font-size: 0.95rem; }
  .loc-meta a:hover { color: var(--clay); }

  @media (max-width: 900px) {
    .intro, .loc { grid-template-columns: minmax(0, 1fr); }
    .hl-strip { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .mosaic { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 560px) {
    .mosaic { grid-template-columns: minmax(0, 1fr); }
    .loc-meta { grid-template-columns: minmax(0, 1fr); }
  }
</style>
